---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

import { getSummerCampWeeks, summerCampSessions } from '../../data/summer-camp';

const weeks = getSummerCampWeeks();
const availableWeeks = weeks.filter((week) => !week.ended);
const weekGroups = [
  { title: 'Available weeks', weeks: availableWeeks, ended: false },
  { title: 'Ended weeks', weeks: weeks.filter((week) => week.ended), ended: true },
];
const campMoney = (cents: number) => `$${cents / 100}`;

const sessionOptions = [
  { label: 'Morning', time: '10 AM–12 PM', regular: '$210', offer: '$105' },
  { label: 'Afternoon', time: '1–3 PM', regular: '$210', offer: '$105' },
  { label: 'Full Day', time: '10 AM–3 PM', regular: '$420', offer: '$210' },
];

// Reuse the original camp service and its allowed return route.
const endpoint = 'https://script.google.com/macros/s/AKfycbzfbWYbO2d_P8Q8kktvc0vvdgFHSUEXIsE2PhPV5MAN60ppmSimWZBNl172vSGty_zIZQ/exec';
---

<BaseLayout
  title="Summer Camp Ages 4–10 | SparkPreneurs Toronto"
  description="Explore SparkPreneurs Summer Camp themes, available weeks, session times, and registration details for ages 4–10."
>
  <a class="programs-skip-link" href="#camp-weeks">Skip to camp weeks</a>

  <SiteHeader current="camps" variant="programs" ctaHref="mailto:sparkpreneurs.ca@gmail.com?subject=Next%20Summer%20Camp%20Dates" ctaLabel="Ask About Next Dates" />

  <main class="summer-detail-page" data-camp-shop data-endpoint={endpoint} data-program-code="summer2026_4_10_sessions" data-return-url="https://sparkpreneurs.ca/summer-camp/">
    <section class="camps-hero" aria-labelledby="summer-title">
      <div class="programs-shell">

        <div class="camps-hero-grid">
          <div class="camps-hero-copy">
            <span class="summer-detail-status">{availableWeeks.length} available weeks</span>
            <span class="eyebrow">SUMMER CAMP · AGES 4–10</span>
            <h1 id="summer-title">Eight weeks of making, stories, food, fashion, and <em>design.</em></h1>
            <p>Choose a themed week and a morning, afternoon, or full-day session. Explore the available weeks below and find your next creative adventure.</p>
            <div class="button-row">
              <a class="button button-primary" href="#camp-weeks">Explore All Eight Weeks <span aria-hidden="true">→</span></a>
              <a class="button button-ghost" href="mailto:sparkpreneurs.ca@gmail.com?subject=Next%20Summer%20Camp%20Dates">Ask About Next Dates</a>
            </div>
          </div>
          <div class="camps-hero-visual">
            <figure class="camps-hero-main"><img src="/images/kids.jpg" alt="Children enjoying a creative camp activity at SparkPreneurs" /></figure>
            <figure class="camps-hero-small"><img src="/images/gallery-kids-clay.jpg" alt="Children proudly showing their handmade clay projects" /></figure>
            <span aria-hidden="true">&#10022;</span>
          </div>
        </div>

      </div>
    </section>

    <section class="summer-detail-status-panel" aria-labelledby="summer-status-title">
      <div class="programs-shell">
        <span aria-hidden="true">i</span>
        <div><span class="eyebrow">CHOOSE YOUR WEEK</span><h2 id="summer-status-title">Two creative weeks to explore.</h2><p>Choose from the available weeks below. Ended weeks are closed to registration.</p></div>
        <a class="button button-secondary" href="mailto:sparkpreneurs.ca@gmail.com?subject=Summer%20Camp%20Updates">Request Camp Updates</a>
      </div>
    </section>

    <section id="camp-weeks" class="summer-detail-schedule" aria-labelledby="camp-weeks-title">
      <div class="programs-shell">
        <div class="summer-detail-section-heading">
          <div><span class="eyebrow">2026 THEMED SCHEDULE</span><h2 id="camp-weeks-title">A different creative world each week.</h2></div>
          <p>Hover over a poster, or tap it, to see dates and session details. Ended weeks are closed to registration.</p>
        </div>
        {weekGroups.map((group) => (
          <div class:list={['camp-week-group', { 'camp-week-group--ended': group.ended }]}>
            <div class="camp-week-group-heading"><h3>{group.title}</h3><span>{group.weeks.length} weeks</span></div>
            <div class:list={{ 'camp-poster-slider': group.ended }} data-ended-slider={group.ended ? '' : undefined} role={group.ended ? 'region' : undefined} aria-roledescription={group.ended ? 'carousel' : undefined} aria-label={group.ended ? 'Ended camp weeks' : undefined}>
              {group.ended && <button class="camp-slider-arrow camp-slider-prev" type="button" data-camp-slider-prev aria-label="Previous ended week" aria-controls="ended-camp-weeks" disabled><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>}
            <div class="camp-poster-grid" id={group.ended ? 'ended-camp-weeks' : undefined} data-camp-slider-track={group.ended ? '' : undefined} tabindex={group.ended ? '0' : undefined} aria-label={group.ended ? 'Scroll through ended weeks' : undefined}>
          {group.weeks.map((item) => (
            <article class:list={['camp-poster-card', { 'is-ended': item.ended }]} aria-labelledby={`camp-week-${item.week}-title`} data-camp-week={item.week}>
              <button class="camp-poster-art" type="button" data-camp-poster-toggle aria-expanded="false" aria-controls={`camp-week-${item.week}-details`} aria-label={`Show details for Week ${Number(item.week)}: ${item.theme}`}>
                <img src={item.image} alt={`Week ${Number(item.week)}: ${item.theme} Summer Camp poster`} loading="lazy" decoding="async" />
                <span class:list={['camp-poster-stamp', { 'camp-poster-stamp--available': !item.ended }]}>{item.ended ? 'Week ended' : 'Available'}</span>
              </button>
              <div class="camp-poster-info" id={`camp-week-${item.week}-details`} data-camp-poster-details aria-hidden="true" inert>
                <h3 class="sr-only" id={`camp-week-${item.week}-title`}>{item.theme}</h3>
                <div class="camp-poster-meta">
                  <span>WEEK {item.week}</span>
                  <p class="camp-poster-date"><time datetime={item.startDate}>{item.dates}</time></p>
                  <button class="camp-poster-close" type="button" data-camp-poster-close aria-label="Hide camp details"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
                </div>
                {item.fourDay && <small class="camp-poster-note">4-day week</small>}
                {!item.ended && <div class="camp-poster-sessions" aria-label="Session times and prices">
                  {summerCampSessions.map((session, index) => (
                    <button type="button" data-camp-session data-week={Number(item.week)} data-session={['AM', 'PM', 'FULL'][index]} data-price={item.sessionPriceCents * session.multiplier} data-name={`Week ${Number(item.week)}: ${item.theme} — ${session.label}`} aria-pressed="false"><span>{session.label}</span><small>{session.time}</small><strong>{campMoney(item.sessionPriceCents * session.multiplier)}</strong><small data-camp-session-label>Add to cart</small></button>
                  ))}
                </div>}
                <div class="camp-poster-footer">
                  {item.ended ? <button type="button" disabled>Registration closed</button> : <><span>Per week + HST</span><a href="#camp-registration">Review cart <span aria-hidden="true">→</span></a></>}
                </div>
              </div>
            </article>
          ))}
            </div>
              {group.ended && <><button class="camp-slider-arrow camp-slider-next" type="button" data-camp-slider-next aria-label="Next ended week" aria-controls="ended-camp-weeks"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button><span class="sr-only" data-camp-slider-status aria-live="polite" aria-atomic="true"></span></>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="summer-detail-sessions" aria-labelledby="session-options-title">
      <div class="programs-shell summer-detail-sessions-layout">
        <div><span class="eyebrow">CHOOSE YOUR SESSION</span><h2 id="session-options-title">Three ways to structure the camp day.</h2><p>Available weeks offer morning, afternoon, and full-day sessions. Review the dates and prices on each available week above.</p></div>
        <div class="summer-session-grid">
          {sessionOptions.map((session, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{session.label}</h3><strong>{session.time}</strong><p><s>{session.regular}</s> {session.offer}</p><small>2026 offer price + HST</small></article>)}
        </div>
      </div>
    </section>

    <section id="camp-registration" class="summer-registration-summary" aria-labelledby="registration-summary-title">
      <div class="programs-shell summer-registration-layout">
        <div>
          <span class="eyebrow">CAMP REGISTRATION</span>
          <h2 id="registration-summary-title">Choose sessions, provide contact details, then pay securely.</h2>
          <p>Add a morning, afternoon, or full-day session for each week, enter your contact details, and review the total before continuing to Stripe. Registration is confirmed after the backend verifies payment.</p>
        </div>
        <div class="summer-registration-card">
          <span>YOUR SELECTED SESSIONS</span>
          <ul data-camp-cart><li>No sessions selected yet.</li></ul>
          <div data-camp-totals hidden><dl><div><dt>Subtotal</dt><dd data-camp-subtotal></dd></div><div><dt>HST (13%)</dt><dd data-camp-tax></dd></div><div><dt>Total (CAD)</dt><dd data-camp-total></dd></div></dl></div>
          <form data-camp-form>
            <label>Participant name<input name="studentName" autocomplete="name" maxlength="100" required /></label>
            <label>Contact name<input name="parentName" autocomplete="name" maxlength="100" required /></label>
            <label>Contact email<input type="email" name="parentEmail" autocomplete="email" required /></label>
            <label>Phone<input type="tel" name="phone" autocomplete="tel" maxlength="40" required /></label>
            <button class="button button-primary" type="submit" data-camp-checkout disabled>Continue to Secure Payment</button>
            <button class="button button-ghost" type="button" data-camp-clear disabled>Clear cart</button>
          </form>
          <p data-camp-status role="status" aria-live="polite">Connecting to secure checkout…</p>
        </div>
      </div>
    </section>

    <section class="programs-help" aria-labelledby="summer-help-title">
      <div class="programs-shell">
        <div><span class="eyebrow">NEXT CAMP SEASON</span><h2 id="summer-help-title">Questions about Summer Camp?</h2><p>Contact SparkPreneurs for the next confirmed dates and help choosing the right sessions.</p></div>
        <a class="button button-light" href="mailto:sparkpreneurs.ca@gmail.com?subject=Next%20Summer%20Camp%20Dates">Contact SparkPreneurs</a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import '../../scripts/summer-camp-checkout.js';
  </script>

  <style>
    [data-camp-session] { display: flex; flex-direction: column; gap: 3px; width: 100%; padding: 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); cursor: pointer; text-align: left; }
    [data-camp-session][aria-pressed="true"] { border-color: var(--orange); background: #fff0df; }
    [data-camp-session]:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
    [data-camp-form] { display: grid; gap: 16px; }
    [data-camp-form] label { display: grid; gap: 6px; font-weight: 600; }
    [data-camp-form] input { width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; }
    [data-camp-form] button:disabled { opacity: .55; cursor: not-allowed; }
    [data-camp-totals] dl { margin: 0; width: 100%; }
    [data-camp-totals] dl div { display: flex; justify-content: space-between; gap: 16px; }
    [data-camp-cart] button { margin-left: 12px; cursor: pointer; }
    [data-camp-status][data-status="error"] { color: #a22727; }
  </style>

  <script>
    document.querySelectorAll<HTMLElement>('[data-ended-slider]').forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-camp-slider-track]');
      const previous = slider.querySelector<HTMLButtonElement>('[data-camp-slider-prev]');
      const next = slider.querySelector<HTMLButtonElement>('[data-camp-slider-next]');
      const status = slider.querySelector<HTMLElement>('[data-camp-slider-status]');
      if (!track || !previous || !next || !status) return;
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.camp-poster-card'));
      const step = () => (cards[0]?.getBoundingClientRect().width || 0) + parseFloat(getComputedStyle(track).gap || '0');
      const update = () => {
        previous.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollWidth - track.clientWidth - track.scrollLeft <= 2;
        const first = Math.round(track.scrollLeft / step());
        const count = Math.round((track.clientWidth + parseFloat(getComputedStyle(track).gap || '0')) / step());
        status.textContent = `Showing ended weeks ${first + 1} to ${Math.min(cards.length, first + count)} of ${cards.length}`;
      };
      const move = (direction: number) => {
        track.scrollBy({ left: direction * step(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      };
      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track) return;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1); }
      });
      new ResizeObserver(update).observe(track);
      update();
    });

    document.querySelectorAll<HTMLElement>('.camp-poster-card').forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>('[data-camp-poster-toggle]');
      const details = card.querySelector<HTMLElement>('[data-camp-poster-details]');
      const close = card.querySelector<HTMLButtonElement>('[data-camp-poster-close]');
      if (!toggle || !details || !close) return;
      const setOpen = (open: boolean) => {
        card.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        details.setAttribute('aria-hidden', String(!open));
        details.inert = !open;
      };
      card.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'touch' && matchMedia('(hover: hover) and (pointer: fine)').matches) setOpen(true);
      });
      card.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'touch' && matchMedia('(hover: hover) and (pointer: fine)').matches && !details.contains(document.activeElement)) setOpen(false);
      });
      toggle.addEventListener('click', () => setOpen(!card.classList.contains('is-open')));
      close.addEventListener('click', () => { toggle.focus({ preventScroll: true }); setOpen(false); });
      card.addEventListener('focusin', (event) => {
        if (event.target instanceof HTMLElement && event.target.matches(':focus-visible')) setOpen(true);
      });
      card.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !card.contains(event.relatedTarget)) setOpen(false);
      });
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { toggle.focus({ preventScroll: true }); setOpen(false); }
      });
      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && !card.contains(event.target)) setOpen(false);
      });
    });

    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return;
      menuButton.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      menuButton.focus();
    });
  </script>
</BaseLayout>
