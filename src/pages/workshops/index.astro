---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProgramNav from '../../components/ProgramNav.astro';

const announcementDetails = [
  { number: '01', title: 'Who it is for', description: 'Audience and exact age range.' },
  { number: '02', title: 'When it happens', description: 'Date, start time, end time, and duration.' },
  { number: '03', title: 'What you will make', description: 'Activity, project, and included materials.' },
  { number: '04', title: 'How to join', description: 'Price, tax, capacity, availability, and the correct action.' },
];
---

<BaseLayout
  title="Creative Workshops | SparkPreneurs Toronto"
  description="Explore short SparkPreneurs workshops in art, pottery, seasonal activities, and creative technology, and join the interest list for future dates."
>
  <a class="programs-skip-link" href="#main-content">Skip to main content</a>

  <SiteHeader current="programs" variant="programs" ctaHref="mailto:sparkpreneurs.ca@gmail.com?subject=Workshop%20Interest" ctaLabel="Join Workshop Interest List" />

  <ProgramNav current="workshops" />

  <main id="main-content" class="workshops-page">
    <section class="workshops-hero" aria-labelledby="workshops-title">
      <div class="programs-shell">
        <div class="workshops-hero-frame">
          <div class="workshops-hero-media"><img src="/images/workshops-hero.jpg" alt="A child painting with colourful art materials" /></div>
          <div class="workshops-hero-copy">
            <span class="eyebrow">SHORT CREATIVE EXPERIENCES</span>
            <h1 id="workshops-title">Come for one idea. Leave with something <em>you made.</em></h1>
            <p>Explore hands-on workshops in art, pottery, seasonal activities, and creative technology. Workshops are short-format experiences rather than recurring classes.</p>
            <div class="button-row">
              <a class="button button-ghost" href="mailto:sparkpreneurs.ca@gmail.com?subject=Workshop%20Interest">Join the Interest List</a>
            </div>
            <dl>
              <div><dt>Format</dt><dd>One-time or short series</dd></div>
              <div><dt>Confirmed audience</dt><dd>Kids & Youth</dd></div>
              <div><dt>Location</dt><dd>Midtown Toronto</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="workshops-past" aria-labelledby="past-workshop-title">
      <div class="programs-shell workshops-past-layout">
        <a class="workshops-past-poster" href="/images/kids-workshops.png" target="_blank" rel="noopener">
          <img src="/images/kids-workshops.png" alt="Previous free Summer Kids Workshops flyer for pottery and fabric painting" loading="lazy" />
          <span>View original flyer</span>
        </a>
        <div class="workshops-past-copy">
          <span class="workshops-ended">Past workshop · ended</span>
          <span class="eyebrow">FROM THE PREVIOUS SCHEDULE</span>
          <h2 id="past-workshop-title">Summer Kids Workshops.</h2>
          <p>The previous flyer featured two free creative sessions with limited spots and RSVP required.</p>
          <dl>
            <div><dt>Activities</dt><dd>Pottery + fabric painting</dd></div>
            <div><dt>Dates shown</dt><dd>Tuesday, July 21 + July 28</dd></div>
            <div><dt>Time shown</dt><dd>5:30–6:30 PM</dd></div>
            <div><dt>Entry</dt><dd>Free · RSVP required</dd></div>
          </dl>
          <p class="workshops-source-note">This flyer is shown as a past-workshop example only. It is not an active RSVP link.</p>
        </div>
      </div>
    </section>

    <section class="workshops-announcement" aria-labelledby="workshop-announcement-title">
      <div class="programs-shell workshops-announcement-layout">
        <div>
          <span class="eyebrow">CLEAR BEFORE YOU RSVP</span>
          <h2 id="workshop-announcement-title">Every scheduled workshop should answer four questions.</h2>
          <p>When a new workshop is published, its card will include the practical details needed to decide and register.</p>
        </div>
        <ol>
          {announcementDetails.map((item) => <li><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="programs-help" aria-labelledby="workshops-help-title">
      <div class="programs-shell">
        <div><span class="eyebrow">WORKSHOP UPDATES</span><h2 id="workshops-help-title">Be first to hear about the next creative session.</h2><p>Tell us who the workshop is for, what they want to make, and which days or times usually work.</p></div>
        <a class="button button-light" href="mailto:sparkpreneurs.ca@gmail.com?subject=Workshop%20Interest">Join the Interest List</a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return;
      menuButton.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      menuButton.focus();
    });
  </script>
</BaseLayout>
