---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProgramNav from '../components/ProgramNav.astro';

const audienceChoices = [
  {
    title: 'Kids & Youth',
    description: 'Explore creative programs, workshops, camps, and after-school experiences for young makers.',
    href: '/programs/kids-youth/',
    label: 'PROGRAMS BY AUDIENCE',
    number: '01',
  },
  {
    title: 'Adults',
    description: 'Find hands-on creative experiences, from pottery to guided art workshops.',
    href: '/programs/adults/',
    label: 'PROGRAMS BY AUDIENCE',
    number: '02',
  },
];

const programHighlights = [
  {
    title: 'Pottery — Wheel',
    description: 'Learn centring, shaping, and glazing through a guided four-session adult course.',
    image: '/images/gallery-pottery.jpg',
    alt: 'Pottery being shaped at SparkPreneurs',
    tag: 'ADULT POTTERY',
    tone: 'orange',
    href: '/programs/pottery-wheel/',
  },
  {
    title: 'Pottery — Hand-Building',
    description: 'Build pottery by hand through pinching, coiling, slab-building, texture, and sculpture.',
    image: '/images/gallery-kids-clay.jpg',
    alt: 'Hand-built clay projects at SparkPreneurs',
    tag: 'ADULT POTTERY',
    tone: 'ink',
    href: '/programs/hand-building-pottery/',
  },
];

const familyPrograms = [
  { title: 'Camps', description: 'Explore creative seasonal camp experiences and check currently available sessions.', href: '/camps/', label: 'SCHOOL-BREAK PROGRAMS' },
  { title: 'After-School Program', description: 'Compare 3-, 4-, and 5-day weekly options for creative afternoons from 3 PM to 5 PM.', href: '/after-school/', label: 'WEEKDAY PROGRAM' },
];

const eventChoices = [
  { title: 'Hosted Events', description: 'Explore creative birthdays, private gatherings, corporate events, and bridal showers led by SparkPreneurs.', href: '/events/', label: 'ACTIVITY + SPACE', id: 'hosted-events' },
  { title: 'Studio Rental', description: 'Ask about using the studio space for your own class, meeting, creative work, or gathering.', href: '/studio-rental/', label: 'SPACE-ONLY INQUIRY', id: 'studio-rental' },
];

const gallery = [
  ['/images/gallery-pottery.jpg', 'Adult hand-building pottery workshop'],
  ['/images/gallery-kids-clay.jpg', 'Kids showing their clay face projects'],
  ['/images/gallery-robotics.jpg', 'A robotics activity at SparkPreneurs'],
  ['/images/studio.jpg', 'The SparkPreneurs studio space'],
];
---

<BaseLayout
  title="SparkPreneurs | Creative Programs for Kids & Adults in Toronto"
  description="A Midtown Toronto community studio for art, pottery, technology, movement, kids programs, adult workshops, and creative events."
>
  <a class="home-skip-link" href="#main-content">Skip to main content</a>
  <SiteHeader variant="home" />

  <ProgramNav />

  <main id="main-content" class="home-page">
    <section class="hero section-grid">
      <div class="hero-copy">
        <span class="eyebrow">CREATIVE COMMUNITY STUDIO · TORONTO</span>
        <h1>Where every idea gets a chance to <em>spark.</em></h1>
        <p class="hero-lede">Art, wellness, and tech programs for kids, teens, and adults—made for exploring new passions, building real skills, and having a lot of fun along the way.</p>
        <div class="button-row">
          <a class="button button-primary" href="/programs/">Find a Program <span aria-hidden="true">→</span></a>
          <a class="button button-ghost" href="#events">Plan an Event</a>
        </div>
        <dl class="hero-facts">
          <div><dt>Kids + adults</dt><dd>Choose your audience</dd></div>
          <div><dt>Hands-on</dt><dd>Learn by making</dd></div>
          <div><dt>Midtown</dt><dd>3445 Yonge St.</dd></div>
        </dl>
      </div>
      <div class="hero-art" data-hero-slider aria-label="A look inside SparkPreneurs">
        <div class="registration-mark top-left"></div>
        <div class="hero-slides">
          <figure class="hero-slide is-active" data-slide>
            <img src="/images/hero-collage.jpg" alt="Kids and adults creating together at SparkPreneurs" width="1080" height="1080" />
            <figcaption><span>CREATIVE COMMUNITY</span><strong>Make together</strong></figcaption>
          </figure>
          <figure class="hero-slide" data-slide aria-hidden="true">
            <img src="/images/gallery-pottery.jpg" alt="An adult hand-building pottery at SparkPreneurs" loading="lazy" />
            <figcaption><span>ART &amp; POTTERY</span><strong>Shape new ideas</strong></figcaption>
          </figure>
          <figure class="hero-slide" data-slide aria-hidden="true">
            <img src="/images/gallery-robotics.jpg" alt="A robotics activity at SparkPreneurs" loading="lazy" />
            <figcaption><span>TECH &amp; MAKING</span><strong>Build with curiosity</strong></figcaption>
          </figure>
          <figure class="hero-slide" data-slide aria-hidden="true">
            <img src="/images/events.jpg" alt="A creative community event at SparkPreneurs" loading="lazy" />
            <figcaption><span>EVENTS &amp; CELEBRATIONS</span><strong>Gather creatively</strong></figcaption>
          </figure>
        </div>
        <div class="slider-controls">
          <button type="button" class="slider-arrow" data-slider-prev aria-label="Previous studio activity">←</button>
          <div class="slider-dots" aria-label="Choose a studio activity">
            <button type="button" class="is-active" data-slider-dot="0" aria-label="Show creative community" aria-current="true"></button>
            <button type="button" data-slider-dot="1" aria-label="Show art and pottery"></button>
            <button type="button" data-slider-dot="2" aria-label="Show technology and making"></button>
            <button type="button" data-slider-dot="3" aria-label="Show events and celebrations"></button>
          </div>
          <button type="button" class="slider-toggle" data-slider-toggle aria-label="Pause slideshow" aria-pressed="false">Ⅱ</button>
          <button type="button" class="slider-arrow" data-slider-next aria-label="Next studio activity">→</button>
        </div>
        <div class="spark-shape" aria-hidden="true">✦</div>
      </div>
    </section>

    <section class="audience-strip" aria-label="Programs for everyone">
      <p>Start with what you need.</p>
      <div class="audience-links">
        <a href="#programs"><span>01</span> Programs <b>→</b></a>
        <a href="/camps/"><span>02</span> Camps <b>→</b></a>
        <a href="/workshops/"><span>03</span> Workshops <b>→</b></a>
        <a href="#studio-rental"><span>04</span> Studio rental <b>→</b></a>
      </div>
    </section>

    <section id="programs" class="section-shell home-journeys">
      <div class="section-heading">
        <div>
          <span class="eyebrow">PROGRAMS BY AUDIENCE</span>
          <h2>Find the right starting point.</h2>
        </div>
        <p>Start with who the program is for. Each audience path brings together relevant activities, formats, and current registration options.</p>
      </div>
      <div class="home-journey-grid">
        {audienceChoices.map((choice) => (
          <a class="home-journey-card" href={choice.href}>
            <span class="home-journey-number">{choice.number}</span>
            <span class="eyebrow">{choice.label}</span>
            <h3>{choice.title}</h3>
            <p>{choice.description}</p>
            <span class="text-link">Explore {choice.title} <b aria-hidden="true">↗</b></span>
          </a>
        ))}
      </div>
    </section>

    <section id="program-highlights" class="home-program-highlights">
      <div class="section-shell">
        <div class="section-heading">
          <div><span class="eyebrow">PROGRAM HIGHLIGHTS</span><h2>Two ways to work with clay.</h2></div>
          <p>Compare the two locally implemented adult pottery programs. Open each program page to review its current schedule, price, and registration status. <a class="home-pottery-link" href="/programs/pottery/">Compare both pottery formats <b aria-hidden="true">→</b></a></p>
        </div>
        <div class="program-grid">
          {programHighlights.map((program) => (
          <a class={`program-card ${program.tone}`} href={program.href}>
            <span class="card-stripe"></span>
            <div class="card-image"><img src={program.image} alt={program.alt} loading="lazy" /></div>
            <div class="card-copy">
              <span class="tag">{program.tag}</span>
              <h3>{program.title}</h3>
              <p>{program.description}</p>
              <span class="text-link">View program <b aria-hidden="true">↗</b></span>
            </div>
          </a>
          ))}
        </div>
      </div>
    </section>

    <section id="camps" class="category-section home-family-section">
      <div class="section-shell">
        <div class="section-heading">
          <div><span class="eyebrow">FAMILY PROGRAMS</span><h2>Camps and After School are different choices.</h2></div>
          <p>Use Camps for school-break programming and After School for recurring weekday care. Each path answers a different set of family questions.</p>
        </div>
        <div class="category-grid">
          {familyPrograms.map((item) => (
            <a class="category-card" href={item.href}>
              <span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">View details <b aria-hidden="true">↗</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="workshops" class="category-section category-section-alt home-workshops-section">
      <div class="section-shell">
        <div class="section-heading">
          <div><span class="eyebrow">SHORT CREATIVE EXPERIENCES</span><h2>Workshops.</h2></div>
          <p>Workshops are focused, hands-on sessions for trying an activity without committing to a recurring program.</p>
        </div>
        <a class="home-workshop-card" href="/workshops/">
          <div><span class="tag">INTEREST LIST OPEN</span><h3>Explore Workshops</h3><p>See the previous kids workshop and ask about future art, pottery, seasonal, and creative technology sessions.</p></div>
          <span class="button button-secondary">View Workshops <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <section id="events" class="category-section home-events-section">
      <div class="section-shell">
        <div class="section-heading">
          <div><span class="eyebrow">GATHER AT SPARKPRENEURS</span><h2>Hosted event or space-only rental?</h2></div>
          <p>Choose Events when SparkPreneurs leads the experience. Choose Studio Rental when you primarily need access to the space.</p>
        </div>
        <div class="category-grid">
          {eventChoices.map((item) => (
            <a id={item.id} class="category-card home-event-card" href={item.href}>
              <span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">{item.title === 'Studio Rental' ? 'Request rental information' : 'Explore hosted events'} <b aria-hidden="true">↗</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="about-section">
      <div class="about-image">
        <img src="/images/studio.jpg" alt="The warm, creative SparkPreneurs studio" loading="lazy" />
        <span class="image-label">OUR SPACE · MIDTOWN TORONTO</span>
      </div>
      <div class="about-copy">
        <span class="eyebrow">MORE THAN AN ART STUDIO</span>
        <h2>A place to make, move, and belong.</h2>
        <p>SparkPreneurs is a community where art, wellness, creativity, and entrepreneurial thinking come together.</p>
        <p>We welcome children, teens, and adults to discover new passions, develop creative skills, and build confidence in a warm, inspiring environment.</p>
        <a class="button button-secondary" href="/about/">Meet SparkPreneurs <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="gallery" class="section-shell gallery-section">
      <div class="section-heading compact">
        <div><span class="eyebrow">INSIDE THE STUDIO</span><h2>Real people. Real projects. Real joy.</h2></div>
        <a class="text-link instagram-link" href="/gallery/">View Full Gallery →</a>
      </div>
      <div class="gallery-grid">
        {gallery.map(([src, alt], index) => <figure class={`gallery-item item-${index + 1}`}><img src={src} alt={alt} loading="lazy" /></figure>)}
      </div>
    </section>

    <section class="cta-section">
      <span class="eyebrow">CHOOSE YOUR NEXT STEP</span>
      <h2>Find the path that fits.</h2>
      <p>Start with Kids & Youth or Adults, then review the current schedule and next action on the relevant program page.</p>
      <div class="button-row centered">
        <a class="button button-primary" href="/programs/">Find a Program <span aria-hidden="true">→</span></a>
        <a class="button button-light" href="mailto:sparkpreneurs.ca@gmail.com">Ask us a question</a>
      </div>
    </section>
  </main>

  <SiteFooter id="contact" />

  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector('[data-menu]');
    button?.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      button?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || button?.getAttribute('aria-expanded') !== 'true') return;
      button.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      button.focus();
    });

    const slider = document.querySelector('[data-hero-slider]');
    const slides = [...(slider?.querySelectorAll('[data-slide]') ?? [])];
    const dots = [...(slider?.querySelectorAll('[data-slider-dot]') ?? [])];
    const sliderToggle = slider?.querySelector('[data-slider-toggle]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeSlide = 0;
    let sliderTimer: number | undefined;
    let sliderPaused = reducedMotion.matches;

    const showSlide = (index: number) => {
      activeSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeSlide;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === activeSlide;
        dot.classList.toggle('is-active', active);
        active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current');
      });
    };

    const updateSliderToggle = () => {
      if (!sliderToggle) return;
      sliderToggle.textContent = sliderPaused ? '▶' : 'Ⅱ';
      sliderToggle.setAttribute('aria-label', sliderPaused ? 'Play slideshow' : 'Pause slideshow');
      sliderToggle.setAttribute('aria-pressed', String(sliderPaused));
    };

    const startSlider = () => {
      window.clearInterval(sliderTimer);
      if (sliderPaused) return;
      sliderTimer = window.setInterval(() => showSlide(activeSlide + 1), 5000);
    };

    slider?.querySelector('[data-slider-prev]')?.addEventListener('click', () => { showSlide(activeSlide - 1); startSlider(); });
    slider?.querySelector('[data-slider-next]')?.addEventListener('click', () => { showSlide(activeSlide + 1); startSlider(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { showSlide(index); startSlider(); }));
    sliderToggle?.addEventListener('click', () => { sliderPaused = !sliderPaused; updateSliderToggle(); startSlider(); });
    slider?.addEventListener('mouseenter', () => window.clearInterval(sliderTimer));
    slider?.addEventListener('mouseleave', startSlider);
    slider?.addEventListener('focusin', () => window.clearInterval(sliderTimer));
    slider?.addEventListener('focusout', startSlider);
    updateSliderToggle();
    startSlider();
  </script>
</BaseLayout>
