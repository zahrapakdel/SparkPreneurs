---
import type { ProgramCardRecord } from '../data/program-catalog';

interface Props {
  program: ProgramCardRecord;
  eager?: boolean;
}

const { program, eager = false } = Astro.props;
---

<article
  class="programs-card"
  data-program-card
  data-audience={program.audience}
  data-activity={program.activity}
  data-format={program.format}
  data-availability={program.availability}
>
  <a class="programs-card-image" href={program.href} aria-label={`${program.action}: ${program.title}`}>
    <img src={program.image} alt={program.alt} loading={eager ? 'eager' : 'lazy'} />
    <span class={`programs-status programs-status-${program.statusTone}`}>{program.status}</span>
  </a>
  <div class="programs-card-copy">
    <div class="programs-card-tags"><span>{program.activityLabel}</span><span>{program.formatLabel}</span></div>
    <h3><a href={program.href}>{program.title}</a></h3>
    <p>{program.description}</p>
    <dl>
      <div><dt>For</dt><dd>{program.audienceLabel}</dd></div>
      <div><dt>Format</dt><dd>{program.formatLabel}</dd></div>
    </dl>
    <a class="programs-card-link" href={program.href}>{program.action} <span aria-hidden="true">{program.external ? '↗' : '→'}</span></a>
  </div>
</article>
